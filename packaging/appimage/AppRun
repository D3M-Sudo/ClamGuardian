#!/bin/sh
set -eu

APPDIR="$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
export APPDIR

case "$(uname -m)" in
    x86_64) multiarch="x86_64-linux-gnu" ;;
    aarch64) multiarch="aarch64-linux-gnu" ;;
    *)
        echo "Unsupported AppImage architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

export PYTHONHOME="$APPDIR"
export PYTHONPATH="$APPDIR/opt/python:$APPDIR/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/$multiarch${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/girepository-1.0:$APPDIR/usr/lib/$multiarch/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
export GIO_EXTRA_MODULES="$APPDIR/usr/lib/$multiarch/gio/modules${GIO_EXTRA_MODULES:+:$GIO_EXTRA_MODULES}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
export SSL_CERT_FILE="$APPDIR/etc/ssl/certs/ca-certificates.crt"
export GTK_THEME="${GTK_THEME:-Adwaita}"

pixbuf_dir="$APPDIR/usr/lib/$multiarch/gdk-pixbuf-2.0/2.10.0/loaders"
if [ -d "$pixbuf_dir" ] && find "$pixbuf_dir" -maxdepth 1 -type f -name '*.so' -print -quit | grep -q .; then
    cache_root="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/clamguardian"
    mkdir -p "$cache_root"
    cache="$cache_root/gdk-pixbuf-loaders-$(basename "$APPDIR").cache"
    GDK_PIXBUF_MODULEDIR="$pixbuf_dir" \
        "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" "$pixbuf_dir"/*.so > "$cache"
    export GDK_PIXBUF_MODULEDIR="$pixbuf_dir"
    export GDK_PIXBUF_MODULE_FILE="$cache"
fi

# Diagnostic entrypoint used by packaging tests to execute a Python smoke
# script inside the exact bundled runtime without starting the GUI event loop.
if [ "${1:-}" = "--python-interpreter" ]; then
    shift
    exec "$APPDIR/usr/bin/python3" -P "$@"
fi

exec "$APPDIR/usr/bin/python3" -P -c \
    'from clamguardian.cli.main import main; raise SystemExit(main())' "$@"
